{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "signal-reach",
      "versioning": "always-bump-patch",
      "bump-minor-pre-major": false,
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "src/plugin.json", "jsonpath": "$.version" },
        "server/reachd/const.py",
        "server/reachd.py",
        "server/reachd/__init__.py",
        "src/reach-core.js",
        "README.md"
      ]
    },
    "studio": {
      "release-type": "node",
      "package-name": "reach-studio",
      "changelog-path": "studio/CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "studio/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
