#!/bin/sh
# Mirrors the pr-title job in .github/workflows/ci.yml.
# Enable with: git config core.hooksPath .githooks
msg=$(head -n1 "$1")
case "$msg" in
  "Merge "*|"Revert "*|fixup!*|squash!*) exit 0 ;;
esac
if ! printf '%s' "$msg" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  echo "commit-msg: subject is not a Conventional Commit:" >&2
  echo "  $msg" >&2
  echo "Expected e.g. 'feat(server): add failover' or 'fix!: drop legacy alias'" >&2
  exit 1
fi
