{
  "name": "simplereach",
  "displayName": "SimpleREACH",
  "description": "Chat with your SimpleREACH models (gpt-4o, claude-opus-4.6, gemini, deepseek\u2026) directly inside VS Code. Zero config \u2014 points at your local REACH endpoint.",
  "version": "1.0.0",
  "publisher": "simplereach",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "reach",
    "simplereach",
    "gpt-4o",
    "claude",
    "openai-compatible"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "simplereach.openChat",
        "title": "REACH: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "simplereach.reload",
        "title": "REACH: Reload Models"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reach",
          "title": "REACH",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "reach": [
        {
          "type": "webview",
          "id": "reach.chat",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "SimpleREACH",
      "properties": {
        "simplereach.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:20777/v1",
          "markdownDescription": "REACH OpenAI-compatible base URL (your local relay or the public pointer URL + `/v1`)."
        },
        "simplereach.accessKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional shared access key (set in the REACH panel \u2192 Settings \u2192 Access)."
        },
        "simplereach.model": {
          "type": "string",
          "default": "gpt-4o",
          "markdownDescription": "Default model for new chats."
        },
        "simplereach.maxTokens": {
          "type": "number",
          "default": 2048,
          "markdownDescription": "Max output tokens per request."
        },
        "simplereach.workspaceContext": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Include the files open in the VS Code editor as context with every chat (default on \u2014 toggle it in the sidebar)."
        },
        "simplereach.contextMaxKb": {
          "type": "number",
          "default": 120,
          "markdownDescription": "Max total workspace-context size (KB) sent per request. Open files are truncated to fit."
        }
      }
    }
  }
}
