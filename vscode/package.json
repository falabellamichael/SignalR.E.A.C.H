{
  "name": "simplereach",
  "displayName": "SimpleREACH",
  "description": "Chat with your SimpleREACH models (gpt-4o, claude-opus-4.6, gemini, deepseek…) directly inside VS Code. Zero config — points at your local REACH endpoint.",
  "version": "1.0.0",
  "publisher": "simplereach",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "reach",
    "simplereach",
    "gpt-4o",
    "claude",
    "openai-compatible"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "simplereach.openChat",
        "title": "REACH: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "simplereach.reload",
        "title": "REACH: Reload Models"
      },
      {
        "command": "simplereach.askSelection",
        "title": "REACH: Ask about this",
        "icon": "$(question)"
      },
      {
        "command": "simplereach.explainSelection",
        "title": "REACH: Explain this",
        "icon": "$(book)"
      },
      {
        "command": "simplereach.refactorSelection",
        "title": "REACH: Refactor this",
        "icon": "$(edit)"
      },
      {
        "command": "simplereach.fixSelection",
        "title": "REACH: Fix this",
        "icon": "$(bug)"
      },
      {
        "command": "simplereach.commentSelection",
        "title": "REACH: Add comments",
        "icon": "$(comment)"
      },
      {
        "command": "simplereach.testSelection",
        "title": "REACH: Generate tests",
        "icon": "$(beaker)"
      },
      {
        "command": "simplereach.optimizeSelection",
        "title": "REACH: Optimize this",
        "icon": "$(rocket)"
      },
      {
        "command": "simplereach.addElementToChat",
        "title": "REACH: Add Element to Chat",
        "icon": "$(add)"
      },
      {
        "command": "simplereach.openBrowser",
        "title": "REACH: Open Browser",
        "icon": "$(globe)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reach",
          "title": "REACH",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "reach": [
        {
          "type": "webview",
          "id": "reach.chat",
          "name": "Chat"
        }
      ]
    },
    "submenus": [
      {
        "id": "reach/selection",
        "label": "REACH"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "reach/selection",
          "group": "navigation@50",
          "when": "editorHasSelection"
        },
        {
          "command": "simplereach.askSelection",
          "group": "navigation@51",
          "when": "editorHasSelection"
        }
      ],
      "reach/selection": [
        {
          "command": "simplereach.explainSelection",
          "group": "1@1"
        },
        {
          "command": "simplereach.refactorSelection",
          "group": "1@2"
        },
        {
          "command": "simplereach.fixSelection",
          "group": "1@3"
        },
        {
          "command": "simplereach.commentSelection",
          "group": "1@4"
        },
        {
          "command": "simplereach.testSelection",
          "group": "1@5"
        },
        {
          "command": "simplereach.optimizeSelection",
          "group": "1@6"
        }
      ]
    },
    "configuration": {
      "title": "SimpleREACH",
      "properties": {
        "simplereach.endpoint": {
          "type": "string",
          "default": "http://127.0.0.1:20777/v1",
          "markdownDescription": "REACH OpenAI-compatible base URL (your local relay or the public pointer URL + `/v1`)."
        },
        "simplereach.accessKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Optional shared access key (set in the REACH panel → Settings → Access)."
        },
        "simplereach.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "markdownDescription": "Default model for new chats."
        },
        "simplereach.maxTokens": {
          "type": "number",
          "default": 2048,
          "markdownDescription": "Max output tokens per request."
        },
        "simplereach.workspaceContext": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Include the files open in the VS Code editor as context with every chat (default on — toggle it in the sidebar)."
        },
        "simplereach.contextMaxKb": {
          "type": "number",
          "default": 120,
          "markdownDescription": "Max total workspace-context size (KB) sent per request. Open files are truncated to fit."
        },
        "simplereach.think": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "WhisperThink — the model runs a private reasoning pass before answering. The reasoning is never shown in the chat flow (hover the 💭 chip on a reply to peek). Toggle in the sidebar."
        },
        "simplereach.thinkModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model used for the private reasoning pass (blank = same model as the chat)."
        },
        "simplereach.thinkMaxTokens": {
          "type": "number",
          "default": 512,
          "markdownDescription": "Max tokens for the private reasoning pass."
        },
        "simplereach.webSearch": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Web search — the model's question is turned into a search query, fresh results + page excerpts are injected before answering (DuckDuckGo; Playwright used for page fetching when installed)."
        },
        "simplereach.searchResults": {
          "type": "number",
          "default": 5,
          "markdownDescription": "Max search results injected per question (1-10)."
        },
        "simplereach.playwright": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Use Playwright (headless Chromium) for page fetching when the module is installed in the extension folder. Falls back to plain HTTP fetching when unavailable."
        },
        "simplereach.agentic": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Agentic mode — the model can propose file edits (shown as accept/reject diffs in the chat) using your workspace tree + open files as context."
        }
      }
    }
  },
  "dependencies": {
    "playwright": "^1.63.0"
  }
}
