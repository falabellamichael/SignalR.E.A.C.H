{
  "name": "reach-studio",
  "productName": "Reach Studio",
  "version": "26.9.10",
  "description": "Desktop workspace for AI agents, browsing, editing, and optional Reach CLI tools",
  "homepage": "https://github.com/falabellamichael/SignalR.E.A.C.H",
  "desktopName": "reach-studio.desktop",
  "main": "main.mjs",
  "scripts": {
    "prestart": "npm run build:editor",
    "start": "electron .",
    "smoke": "npm run build:editor && electron . --smoke",
    "test": "node scripts/check-syntax.cjs && node --test \"test/**/*.test.cjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=agent/** --test-coverage-include=browser/** --test-coverage-include=renderer/** \"test/**/*.test.cjs\"",
    "test:agent": "node test/agent.test.cjs && node --test test/team-nurse.test.cjs test/team-nurse-benchmark.test.cjs test/team-nurse-work-conserving.test.cjs test/team-runner-stale-output.test.cjs test/team-runner-links-send-completion.test.cjs && node --test test/regressions.test.cjs && node --test test/agent-net.test.cjs && node --test test/budgets.test.cjs && node --test test/browser-tools.test.cjs && node --test test/platform.test.cjs && node --test test/activity.test.cjs && node --test test/compaction.test.cjs && node --test test/budget-awareness.test.cjs && node --test test/code-index.test.cjs && node --test test/refactor.test.cjs && node --test test/refactor-syntax.test.cjs && node --test test/patch-manager.test.cjs && node --test test/sandbox.test.cjs && node --test test/sandbox-gating.test.cjs && node --test test/code-tools.test.cjs && node --test test/code-context.test.cjs && node --test test/connections.test.cjs && node --test test/smoke-templates.test.cjs && node --test test/team-connections.test.cjs && node --test test/team-runner-connections.test.cjs && node --test test/context-injection.test.cjs && node --test test/test-loop.test.cjs && node --test test/test-loop-syntax.test.cjs && node --test test/ts-toolchain.test.cjs && node --test test/state-sync.test.cjs && node --test test/telemetry.test.cjs test/tool-policy.test.cjs",
    "bench:nurse": "node bench/team-nurse-benchmark.cjs",
    "test:workspace": "electron test/telemetry-ui.cjs",
    "test:teams-ui": "electron test/team-deck-ui.cjs",
    "test:teams-click-ui": "electron test/team-deck-tab-click-ui.cjs",
    "test:agents-ui": "electron test/agents-scroll-ui.cjs",
    "test:persona-ui": "electron test/persona-modal-ui.cjs",
    "build:editor": "esbuild renderer/editor.src.js --bundle --minify --format=iife --outfile=renderer/editor.bundle.js",
    "build:activity": "node scripts/build-activity.cjs",
    "check:activity": "node scripts/build-activity.cjs --check",
    "dist": "npm run build:editor && electron-builder",
    "dist:mac": "npm run build:editor && electron-builder --mac",
    "dist:win": "npm run build:editor && electron-builder --win",
    "dist:linux": "npm run build:editor && electron-builder --linux",
    "check": "node scripts/check-syntax.cjs"
  },
  "author": "Michael Anthony Falabella <falabellamichael@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "electron": "44.4.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.falab.reachstudio",
    "productName": "Reach Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "renderer/**/*",
      "agent/**/*",
      "browser/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Reach Studio"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "identity": "-"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "zip",
        "flatpak"
      ],
      "category": "Development",
      "icon": "assets/icon.png",
      "maintainer": "Michael Anthony Falabella <falabellamichael@gmail.com>",
      "synopsis": "Desktop workspace for AI agents, browsing, editing, and optional Reach CLI tools",
      "syncDesktopName": true
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "finishArgs": [
        "--socket=wayland",
        "--socket=x11",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--filesystem=home",
        "--filesystem=xdg-run/reach-studio:create",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.freedesktop.secrets",
        "--env=ELECTRON_TRASH=gio"
      ]
    },
    "extraResources": [
      {
        "from": "../vscode/engine-core.js",
        "to": "engine-core.cjs"
      }
    ]
  },
  "allowScripts": {
    "electron@44.3.0": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
